{
  "name": "swarnay-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/cli/db-migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "test": "vitest run",
    "gen:client": "tsx src/cli/generate-client.ts",
    "gen:docs": "tsx src/cli/generate-docs.ts",
    "seed:superadmin": "tsx src/cli/seed-superadmin.ts",
    "gen:postman": "tsx src/cli/generate-postman.ts",
    "db:backfill-roles": "tsx src/cli/backfill-roles.ts",
    "db:backfill-masters": "tsx src/cli/backfill-masters.ts",
    "db:backfill-orders": "tsx src/cli/backfill-orders.ts",
    "db:backfill-dashboard": "tsx src/cli/backfill-dashboard.ts",
    "routes:audit": "tsx src/cli/route-audit.ts",
    "db:migrate-role-types": "tsx src/cli/migrate-role-types.ts"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.6",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
