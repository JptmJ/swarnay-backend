DB_TARGET=supabase

DATABASE_URL_SUPABASE=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL_SUPABASE=no-verify

DATABASE_URL_DEPLOYED=postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_SSL_DEPLOYED=false

DATABASE_POOL_MAX=10
DB_HEARTBEAT_SECONDS=60

SCHEMA_SYNC_MODE=safe

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

JWT_SECRET=change-me-to-something-long-and-random
JWT_ACCESS_TTL=15m

CORS_ORIGINS=http://localhost:5173,http://localhost:4100
